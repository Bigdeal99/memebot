# Copy to .env and fill in. Never commit .env.

# Only "paper" exists in this version: real market data, fake money.
MODE=paper
DATA_DIR=data

# --- AI brain (optional). Without a key only the non-AI strategies trade. ---
# Get a key at https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
# Hard daily cap on Grok calls. Each call also pays for the X posts Grok reads.
AI_MAX_CALLS_PER_DAY=20
# Only ask Grok about tokens at or above this momentum score (0-100).
AI_MIN_MOMENTUM=55

# --- Phone alerts (optional). Create a bot with @BotFather, get your chat id from @userinfobot. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paper money ---
PAPER_BANKROLL_USD=50
POSITION_USD=5
# Fees + priority fee + slippage per buy or sell, in percent. Price impact is added on top automatically.
FRICTION_PCT_PER_SIDE=1.0

# --- Which tokens are even considered ---
# Do not buy pools younger than this (minutes). The first hour is where most instant rugs happen.
MIN_AGE_MIN=60
MIN_LIQUIDITY_USD=15000
MIN_MCAP_USD=30000
MAX_MCAP_USD=30000000
MAX_AGE_HOURS=48
MIN_TXNS_H1=150
MIN_VOLUME_H1_USD=10000

# --- Safety rules (any failure = never buy) ---
MAX_TOP10_PCT=30
MAX_SINGLE_HOLDER_PCT=10
MAX_INSIDER_PCT=10
MAX_RUGCHECK_SCORE=50
MIN_LP_LOCKED_PCT=80
FAIL_ON_DANGER=true
STRICT_UNKNOWN=true

# --- Timing ---
DISCOVERY_EVERY_SEC=60
EVALUATE_EVERY_SEC=10
MONITOR_EVERY_SEC=5
SUMMARY_EVERY_MIN=60
RECHECK_AFTER_MIN=5
MAX_CHECKS_PER_TOKEN=36
USE_PUMPPORTAL=true
MIGRATION_DELAY_MIN=3
